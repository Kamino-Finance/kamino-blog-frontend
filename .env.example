# Kamino Blog — build-time environment (never exposed to the browser)

# Sanity read token — pulls published content at build time.
# Create at manage.sanity.io -> project 2kksiz70 -> API -> Tokens -> Viewer (read).
# Without it, the build falls back to the committed seed content.
SANITY_READ_TOKEN=

# --- Production build only (leave unset for local dev at root) ---
# Serve under a subpath, e.g. kamino.com/blog (sets asset paths + router basename):
# BLOG_BASE=/blog/
# Canonical URL for sitemap.xml + feed.xml:
# SITE_URL=https://kamino.com/blog
# Override the Sanity project id (defaults to 2kksiz70):
# SANITY_PROJECT_ID=2kksiz70
