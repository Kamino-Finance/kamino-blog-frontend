{
  "name": "@kamino/blog-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "import": "sanity dataset import ../seed.ndjson production --replace",
    "test": "node --test functions/**/*.test.ts",
    "typecheck": "tsc --noEmit",
