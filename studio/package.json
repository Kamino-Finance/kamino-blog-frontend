    "blueprints:plan": "sanity blueprints plan",
    "blueprints:deploy": "sanity blueprints deploy"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@sanity/functions": "^1.5.0",
    "@sanity/vision": "^6.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanity": "^6.8.0",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.23.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.0"
  }
}
